# Contact form. Copy to .env.local for local work, and set the same three in the
# hosting dashboard before deploying. .env* is gitignored — never commit real keys.

# Transactional email key from the Brevo dashboard.
BREVO_API_KEY=

# Address that receives enquiries.
CONTACT_TO=emmanuelkorantenga@gmail.com

# Sender address. Must be verified in Brevo or it rejects the send.
CONTACT_FROM=
